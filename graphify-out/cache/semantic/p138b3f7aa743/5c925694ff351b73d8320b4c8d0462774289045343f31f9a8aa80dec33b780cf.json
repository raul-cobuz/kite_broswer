{"nodes": [{"id": "readme_kite_browser", "label": "Kite Browser", "file_type": "document", "source_file": "README.md", "source_location": "README.md:1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lightweight Linux browser built on GTK3 + WebKitGTK rather than Chromium; the WebKit base is what forces the extension and ad-block design limits documented later."}, {"id": "readme_build_system", "label": "Make + CMake build workflow", "file_type": "document", "source_file": "README.md", "source_location": "README.md:11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_adblock_blocking", "label": "Ad blocking (content blockers + in-page YouTube removal)", "file_type": "document", "source_file": "README.md", "source_location": "README.md:98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses WebKit content blockers instead of Chrome's declarativeNetRequest or webRequest, which WebKitGTK does not provide; YouTube ads are removed in-page because they are first-party."}, {"id": "readme_filters_json", "label": "filters.json generated filters", "file_type": "document", "source_file": "README.md", "source_location": "README.md:27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated from a domain list by update_filters.py; loaded from the executable's directory or CWD as fallback, so install must ship it next to the binary."}, {"id": "readme_profiles", "label": "Named and guest profiles", "file_type": "document", "source_file": "README.md", "source_location": "README.md:161", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each named profile gets its own config/data directories for isolated history, bookmarks, settings, extensions and website data; switching writes an active-profile marker and relaunches because WebKit contexts cannot be re-scoped in place. Guest mode is a throwaway directory deleted on exit."}, {"id": "readme_sync", "label": "Folder-based sync", "file_type": "document", "source_file": "README.md", "source_location": "README.md:82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sync is a user-chosen folder plus a kite-sync.json file rather than a server, keeping the browser dependency-free; cookies, passwords and extensions intentionally stay local."}, {"id": "readme_kite_sync_json", "label": "kite-sync.json", "file_type": "document", "source_file": "README.md", "source_location": "README.md:180", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_command_palette", "label": "Command palette (Ctrl+K)", "file_type": "document", "source_file": "README.md", "source_location": "README.md:77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dark_mode", "label": "Persistent dark mode with hue preservation", "file_type": "document", "source_file": "README.md", "source_location": "README.md:87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recolors page colors preserving hue instead of inverting them, because inversion ruins images and brand colors; a Google Search fallback handles gradient result cards that CSS recoloring misses."}, {"id": "readme_omnibox", "label": "Omnibox suggestions and completion", "file_type": "document", "source_file": "README.md", "source_location": "README.md:83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local-first: suggestions come from history, bookmarks, pins and open tabs before any network search, so no remote suggest service is contacted."}, {"id": "readme_url_normalization", "label": "Omnibox URL normalization rules", "file_type": "document", "source_file": "README.md", "source_location": "README.md:89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "localhost/IP -> http, domains -> https, absolute paths -> file://, everything else -> Google search; defaults to https for security while keeping local dev addresses working."}, {"id": "readme_extensions", "label": "Custom extension runtime", "file_type": "document", "source_file": "README.md", "source_location": "README.md:186", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a full Chrome implementation: WebKitGTK cannot install .crx packages or run Chrome's webRequest/declarativeNetRequest/service-worker model, so background pages are hosted in offscreen windows and only a practical chrome.* subset is supported. Content scripts share Kite's content manager, so they also run in incognito tabs."}, {"id": "readme_manifest_json", "label": "Extension manifest.json", "file_type": "document", "source_file": "README.md", "source_location": "README.md:188", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_permissions", "label": "Permission prompts with per-site memory", "file_type": "document", "source_file": "README.md", "source_location": "README.md:85", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_settings_ini", "label": "settings.ini configuration", "file_type": "document", "source_file": "README.md", "source_location": "README.md:102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain INI in ~/.config/kite keeps settings human-editable and greppable; it also doubles as storage for permission decisions and per-host zoom, avoiding a second config format."}, {"id": "readme_kite_db", "label": "kite.db SQLite store", "file_type": "document", "source_file": "README.md", "source_location": "README.md:154", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "History, bookmarks and pinned links share one SQLite file because queries (omnibox suggestions, start page) span all three; session state lives separately in session.ini at mode 0600."}, {"id": "readme_session_restore", "label": "Session restore and recently closed tabs", "file_type": "document", "source_file": "README.md", "source_location": "README.md:93", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restore opens the previous pinned tabs first and then an active fresh start page, so restoring never blocks a clean new-tab start; incognito state is never persisted."}, {"id": "readme_split_view", "label": "Split view (two tabs side by side)", "file_type": "document", "source_file": "README.md", "source_location": "README.md:74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toolbar, navigation and find bar follow the focused pane, so one set of chrome serves both panes instead of duplicating controls."}, {"id": "readme_start_page", "label": "kite://newtab start page", "file_type": "document", "source_file": "README.md", "source_location": "README.md:94", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom quick links are stored separately from pinned tabs because pinned links belong to history/pin storage while start-page links are pure appearance config."}, {"id": "readme_internal_pages", "label": "kite:// internal pages", "file_type": "document", "source_file": "README.md", "source_location": "README.md:256", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal pages give settings, history, bookmarks, profiles, sync and extensions a UI without a native dialog toolkit dependency; content scripts are blocked on them for safety."}, {"id": "readme_default_browser_registration", "label": "Default browser registration", "file_type": "document", "source_file": "README.md", "source_location": "README.md:59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shortcuts", "label": "Keyboard shortcuts table", "file_type": "document", "source_file": "README.md", "source_location": "README.md:229", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_omnibox_bangs", "label": "Omnibox bangs (!yt, !gh, !w, !r)", "file_type": "document", "source_file": "README.md", "source_location": "README.md:254", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_build_system", "target": "cmakelists_mybrowser", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:14", "weight": 1.0}, {"source": "readme_kite_browser", "target": "readme_build_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:11", "weight": 1.0}, {"source": "readme_filters_json", "target": "readme_adblock_blocking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:98", "weight": 1.0}, {"source": "readme_sync", "target": "readme_kite_sync_json", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:180", "weight": 1.0}, {"source": "readme_sync", "target": "readme_profiles", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": "README.md:161", "weight": 0.75}, {"source": "readme_omnibox", "target": "readme_url_normalization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:89", "weight": 1.0}, {"source": "readme_omnibox", "target": "readme_omnibox_bangs", "relation": "references", "c
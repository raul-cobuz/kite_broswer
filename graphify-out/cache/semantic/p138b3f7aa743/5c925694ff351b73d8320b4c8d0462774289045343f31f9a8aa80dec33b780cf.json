me_internal_pages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:256", "weight": 1.0}, {"source": "readme_start_page", "target": "readme_settings_ini", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:151", "weight": 1.0}, {"source": "readme_kite_db", "target": "readme_internal_pages", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:91", "weight": 0.95}, {"source": "readme_profiles", "target": "readme_settings_ini", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:165", "weight": 1.0}, {"source": "readme_default_browser_registration", "target": "readme_kite_browser", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:59", "weight": 1.0}, {"source": "readme_shortcuts", "target": "readme_split_view", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:236", "weight": 1.0}, {"source": "readme_shortcuts", "target": "readme_command_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:246", "weight": 1.0}, {"source": "readme_kite_browser", "target": "data_kite_icon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:286", "weight": 1.0}], "hyperedges": [{"id": "kite_privacy_isolation_model", "label": "Kite privacy and data-isolation model", "nodes": ["readme_profiles", "readme_permissions", "readme_adblock_blocking", "readme_settings_ini", "readme_kite_db", "readme_session